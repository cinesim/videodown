{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": false,
  "printWidth": 100,
  "trailingComma": "none",
  "sortPackageJson": false,
  "ignorePatterns": [
    ".claude/**",
    ".context/**",
    "**/out/**",
    "**/dist/**",
    "**/.next/**",
    "**/.open-next/**",
    "**/.wrangler/**",
    "packages/desktop/src/renderer/src/assets/themes/**",
    "packages/muyajs/**"
  ]
}
