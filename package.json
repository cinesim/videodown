{
  "name": "marktext-monorepo",
  "version": "0.20.0-dev",
  "description": "MarkText monorepo root",
  "private": true,
  "homepage": "https://github.com/marktext/marktext",
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "packages/*",
    "packages/muya/examples",
    "packages/muya/e2e"
  ],
  "overrides": {
    "postcss": "8.5.15",
    "esbuild@>=0.27.0 <0.28.1": "0.28.1"
  },
  "trustedDependencies": [
    "ced",
    "electron",
    "electron-winstaller",
    "esbuild",
    "keytar",
    "native-keymap",
    "sharp",
    "unrs-resolver",
    "workerd"
  ],
  "scripts": {
    "postinstall": "tsx scripts/postinstall.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "minify-locales": "tsx scripts/minify-locales.ts",
    "rebuild-native": "bun run --filter marktext rebuild-native",
    "start": "bun run --filter marktext start",
    "dev": "bun run --filter marktext dev",
    "build": "bun run --filter marktext build",
    "build:unpack": "bun run --filter marktext build:unpack",
    "build:win": "bun run --filter marktext build:win",
    "build:win:x64": "bun run --filter marktext build:win:x64",
    "build:win:arm64": "bun run --filter marktext build:win:arm64",
    "build:mac": "bun run --filter marktext build:mac",
    "build:mac:x64": "bun run --filter marktext build:mac:x64",
    "build:mac:arm64": "bun run --filter marktext build:mac:arm64",
    "build:linux": "bun run --filter marktext build:linux",
    "perf:inspect": "bun run --filter marktext perf:inspect",
    "perf:inspect-brk": "bun run --filter marktext perf:inspect-brk",
    "test": "bun run --filter marktext test",
    "test:unit": "bun run --filter marktext test:unit",
    "test:e2e": "bun run --filter marktext test:e2e",
    "typecheck": "bun run --filter marktext typecheck",
    "typecheck:watch": "bun run --filter marktext typecheck:watch",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "gen-third-party": "tsx scripts/generateThirdPartyLicense.ts",
    "validate-licenses": "tsx scripts/validateLicenses.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,ts,tsx,vue}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "**/*.{css,scss,less,html,json,jsonc,json5,md,mdx,yaml,yml,toml}": [
      "oxfmt --write"
    ]
  },
  "devDependencies": {
    "electron": "~42.1.0",
    "husky": "^9.1.7",
    "license-checker": "^25.0.1",
    "lint-staged": "^17.2.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "tsx": "^4.22.4"
  }
}
