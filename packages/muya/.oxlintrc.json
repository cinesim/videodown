{
    "$schema": "../../node_modules/oxlint/configuration_schema.json",
    "plugins": ["eslint", "typescript", "unicorn", "oxc", "vitest"],
    "categories": {
        "correctness": "off"
    },
    "env": {
        "builtin": true,
        "browser": true,
        "node": true,
        "vitest": true
    },
    "ignorePatterns": [
        "test/spec/fixtures/**",
        "test/spec/expected-failures.json",
        "test/spec/conformance.md",
        "examples/**",
        "e2e/**",
        "lib/**",
        "docs/**",
        "src/utils/diagram/sequence/sequence-diagram-snap.js"
    ],
    "rules": {
        "complexity": ["warn", { "max": 20 }],
        "eqeqeq": ["error", "smart"],
        "max-lines-per-function": ["warn", 200],
        "no-console": ["error", { "allow": ["warn", "error"] }],
        "no-debugger": "error",
        "typescript/no-explicit-any": "error",
        "vitest/prefer-lowercase-title": ["error", { "allowedPrefixes": ["PG"] }]
    },
    "overrides": [
        {
            "files": ["**/*.spec.ts", "**/*.spec.tsx", "**/*.test.ts", "**/*.test.tsx"],
            "rules": {
                "no-unused-expressions": "off"
            }
        }
    ]
}
